<file path="backend/README.md">
# Backend setup

1. Copy `.env.example` to `.env.local`. This file is ignored by Git.
2. In MongoDB Atlas, create a database user, allow your server's IP address in
   Network Access, and copy the application's connection string into `MONGO_URI`.
   Replace the username, password, and cluster host in the example URI. Do not
   commit the real connection string.
3. Set `JWT_SECRET` to a long, random value and keep it unchanged between server
   restarts. A changed secret invalidates existing login tokens.
4. Start the API with `npm install` followed by `npm run dev`.

Users and password hashes are stored in the MongoDB database selected by
`MONGO_URI`, so they remain available after the API server restarts. The
frontend uses the active Expo host (or the browser's host) by default. Set
`EXPO_PUBLIC_API_URL` only when the API is hosted at a different address; use a
LAN-reachable address for a physical device.
</file>

<file path="backend/server.js">
const express = require("express");
const cors = require("cors");
const helmet = require("helmet");
const rateLimit = require("express-rate-limit");
const path = require("path");
require("dotenv").config({ path: path.join(__dirname, ".env.local") });
require("dotenv").config({ path: path.join(__dirname, ".env") });

const connectDB = require("./config/db");
const authRoutes = require("./routes/authRoutes");
const pregnancyRoutes = require("./routes/pregnancyRoutes");
const childRoutes = require("./routes/childRoutes");
const healthRoutes = require("./routes/healthRoutes");
const appointmentRoutes = require("./routes/appointments");
const medicineRoutes = require("./routes/medicines");
const reportRoutes = require("./routes/reportRoutes");

const app = express();
const PORT = process.env.PORT || 5000;

// Security
app.use(helmet());


// CORS
app.use(cors());

app.use((req, res, next) => {
  const startedAt = Date.now();

  res.on("finish", () => {
    console.log(
      `${new Date().toISOString()} ${req.method} ${req.originalUrl.split("?")[0]} ${res.statusCode} ${Date.now() - startedAt}ms`
    );
  });

  next();
});

// JSON body parser with support for image uploads
app.use(express.json({ limit: "15mb" }));
app.use(express.urlencoded({ extended: true, limit: "15mb" }));

// Rate limiting
const limiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 100,
  message: {
    success: false,
    message: "Too many requests. Please try again later.",
  },
});

app.use("/api", limiter);

// Health check
app.get("/", (req, res) => {
  res.json({
    success: true,
    message: "Little Bloom API is running 🌸",
  });
});

app.get("/api/status", (req, res) => {
  res.json({
    success: true,
    message: "Little Bloom backend is healthy 🌸",
  });
});

// Authentication routes
app.use("/api/auth", authRoutes);
app.use("/api/pregnancy", pregnancyRoutes);
app.use("/api/child", childRoutes);
app.use("/api/health", healthRoutes);
app.use("/api/appointments", appointmentRoutes);
app.use("/api/medicines", medicineRoutes);
app.use("/api/reports", reportRoutes);
app.use("/api/vaccinations", require("./routes/vaccinations"));
app.use("/api/journal", require("./routes/journalRoutes"));
app.use("/api/chatbot", require("./routes/chatbotRoutes"));

app.use((error, req, res, next) => {
  if (res.headersSent) {
    next(error);
    return;
  }

  if (error?.type === "entity.parse.failed") {
    res.status(400).json({
      success: false,
      message: "Request body contains invalid JSON. Please try again.",
    });
    return;
  }

  next(error);
});

// Start server
if (require.main === module) {
  if (!process.env.JWT_SECRET?.trim()) {
    console.error("JWT_SECRET is not configured. Set it in backend/.env.");
    process.exitCode = 1;
  } else {
    console.log(`Starting Little Bloom API on port ${PORT}...`);
    connectDB().then(() => {
      app.listen(PORT, "0.0.0.0", () => {
        console.log(`🌸 Little Bloom server running on port ${PORT}`);
      });
    }).catch((error) => {
      console.error("❌ Unable to start Little Bloom server:", error.message);
      process.exitCode = 1;
    });
  }
}

module.exports = app;
