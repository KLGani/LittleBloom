  // Default English Dynamic Generator
  return (
    `🌸 Little Bloom Healthcare Guide for ${name}:\n\n` +
    `Regarding your question: "${cleanMsg}"\n\n` +
    `During ${mode === "child" ? "early childhood development" : "pregnancy"}, every experience and symptom is deeply meaningful. Here is evidence-based maternal guidance:\n\n` +
