import React, { useState } from "react";
import {
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View,
} from "react-native";
import { router } from "expo-router";
import * as SecureStore from "../utils/storage";
import { goBackOrReplace } from "../utils/navigation";

import { createChildProfile } from "../../services/api";
import { useLanguage } from "../context/LanguageContext";
import { LanguageSelectorModal } from "../components/LanguageSelectorModal";

export default function ChildProfileScreen() {
  const { language, t } = useLanguage();
  const [showLangModal, setShowLangModal] = useState(false);

  const [childName, setChildName] = useState("");
  const [dateOfBirth, setDateOfBirth] = useState("");
  const [gender, setGender] = useState("Other");
  const [bloodGroup, setBloodGroup] = useState("");
  const [height, setHeight] = useState("");
  const [weight, setWeight] = useState("");
  const [notes, setNotes] = useState("");

  const [loading, setLoading] = useState(false);
  const [saveError, setSaveError] = useState("");

  const genderOptions = [
    { label: t.male, value: "Male" },
    { label: t.female, value: "Female" },
    { label: t.other, value: "Other" },
  ];

  const handleSave = async () => {
    setSaveError("");

    if (!childName.trim()) {
      setSaveError(t.childName + " is required.");
      return;
    }

    if (!dateOfBirth.trim()) {
      setSaveError(t.dateOfBirth + " is required.");
      return;
    }

    const normalizedDate = dateOfBirth.trim();
    const dateMatch =
      normalizedDate.match(/^(\d{2})[-/](\d{2})[-/](\d{4})$/) ||
      normalizedDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);

    if (!dateMatch) {
      setSaveError("Please enter the date as DD-MM-YYYY, DD/MM/YYYY, or YYYY-MM-DD.");
      return;
    }

    const [, first, second, third] = dateMatch;
    const [year, month, day] =
      first.length === 4
        ? [first, second, third]
        : [third, second, first];
    const parsedDate = new Date(Number(year), Number(month) - 1, Number(day));

    if (
      parsedDate.getFullYear() !== Number(year) ||
      parsedDate.getMonth() !== Number(month) - 1 ||
      parsedDate.getDate() !== Number(day) ||
      parsedDate.getTime() > new Date().setHours(23, 59, 59, 999)
    ) {
      setSaveError("Please enter a valid date that is not in the future.");
      return;
    }

    const measurements = [
      ["Height", height],
      ["Weight", weight],
    ] as const;
    for (const [label, value] of measurements) {
      if (value.trim() && (!Number.isFinite(Number(value)) || Number(value) <= 0)) {
        setSaveError(`${label} must be a number greater than zero.`);
        return;
      }
    }

    try {
      setLoading(true);

      const token = await SecureStore.getItemAsync("authToken");

      if (!token) {
        router.replace("/");
        return;
      }

      const profileData = {
        childName: childName.trim(),
        dateOfBirth: `${year}-${month}-${day}`,
        gender,
        bloodGroup: bloodGroup.trim(),
        height: height.trim() ? Number(height) : null,
        weight: weight.trim() ? Number(weight) : null,
        notes: notes.trim(),
      };

      const result = await createChildProfile(token, profileData);

      if (result.success) {
        router.replace("/dashboard");
      } else {
        setSaveError(result.message || "Something went wrong.");
      }
    } catch (error) {
      console.error("Child profile error:", error);
      setSaveError(
        error instanceof Error
          ? error.message
          : "Something went wrong while saving the child profile."
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.container}
      behavior={Platform.OS === "ios" ? "padding" : undefined}
    >
      <ScrollView
        contentContainerStyle={styles.scrollContent}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
      >
        {/* Header */}
        <View style={styles.header}>
          <TouchableOpacity
            style={styles.backButton}
            onPress={() => goBackOrReplace("/mode-selection")}
            activeOpacity={0.7}
          >
            <Text style={styles.backText}>‹</Text>
          </TouchableOpacity>

          <View style={styles.headerInfo}>
            <Text style={styles.smallTitle}>{t.appName.toUpperCase()}</Text>
            <Text style={styles.title}>{t.childProfile}</Text>
          </View>

          <TouchableOpacity
            style={styles.langPill}
            onPress={() => setShowLangModal(true)}
            activeOpacity={0.8}
          >
            <Text style={styles.langPillText}>🌐 {language} ▾</Text>
          </TouchableOpacity>
        </View>

        {/* Introduction */}
        <View style={styles.introCard}>
          <Text style={styles.introEmoji}>👶</Text>
          <View style={styles.introTextContainer}>
            <Text style={styles.introTitle}>{t.childProfileSubtitle}</Text>
            <Text style={styles.introText}>{t.childProfileDesc}</Text>
          </View>
        </View>

        {/* Basic Information */}
        <Text style={styles.sectionTitle}>{t.basicInformation}</Text>

        <View style={styles.card}>
          <Text style={styles.label}>{t.childName} *</Text>
          <TextInput
            style={styles.input}
            placeholder="Example: Aarav"
            placeholderTextColor="#8AA9A2"
            value={childName}
            onChangeText={setChildName}
            autoCapitalize="words"
          />

          <Text style={styles.label}>{t.dateOfBirth} *</Text>
          <TextInput
            style={styles.input}
            placeholder="DD-MM-YYYY"
            placeholderTextColor="#8AA9A2"
            value={dateOfBirth}
            onChangeText={setDateOfBirth}
            keyboardType="numbers-and-punctuation"
            maxLength={10}
          />
          <Text style={styles.helperText}>Example: 10-04-2025</Text>

          <Text style={styles.label}>{t.gender}</Text>
          <View style={styles.genderContainer}>
            {genderOptions.map((item) => (
              <TouchableOpacity
                key={item.value}
                style={[
                  styles.genderButton,
                  gender === item.value && styles.genderButtonSelected,
                ]}
                onPress={() => setGender(item.value)}
                activeOpacity={0.8}
              >
                <Text
                  style={[
                    styles.genderText,
                    gender === item.value && styles.genderTextSelected,
                  ]}
                >
                  {item.label}
                </Text>
              </TouchableOpacity>
            ))}
          </View>
        </View>

        {/* Health Information */}
        <Text style={styles.sectionTitle}>{t.healthInformation}</Text>

        <View style={styles.card}>
          <Text style={styles.label}>{t.bloodGroup}</Text>
          <TextInput
            style={styles.input}
            placeholder="Example: B+"
            placeholderTextColor="#8AA9A2"
            value={bloodGroup}
            onChangeText={setBloodGroup}
            autoCapitalize="characters"
            maxLength={4}
          />

          <Text style={styles.label}>{t.height}</Text>
          <TextInput
            style={styles.input}
            placeholder="Example: 72"
            placeholderTextColor="#8AA9A2"
            keyboardType="decimal-pad"
            value={height}
            onChangeText={setHeight}
          />

          <Text style={styles.label}>{t.weight}</Text>
          <TextInput
            style={styles.input}
            placeholder="Example: 8.2"
            placeholderTextColor="#8AA9A2"
            keyboardType="decimal-pad"
            value={weight}
            onChangeText={setWeight}
          />
        </View>

        {/* Notes */}
        <Text style={styles.sectionTitle}>{t.additionalNotes}</Text>

        <View style={styles.card}>
          <TextInput
            style={[styles.input, styles.notesInput]}
            placeholder={t.childNotesPlaceholder}
            placeholderTextColor="#8AA9A2"
            value={notes}
            onChangeText={setNotes}
            multiline
            textAlignVertical="top"
          />
        </View>

        {/* Privacy */}
        <View style={styles.privacyCard}>
          <Text style={styles.privacyIcon}>🔒</Text>
          <Text style={styles.privacyText}>{t.privacyNotice}</Text>
        </View>

        {/* Save */}
        <TouchableOpacity
          style={[styles.saveButton, loading && styles.disabledButton]}
          onPress={handleSave}
          disabled={loading}
          activeOpacity={0.8}
        >
          {loading ? (
            <ActivityIndicator color="#FFFFFF" />
          ) : (
            <>
              <Text style={styles.saveButtonText}>{t.saveChildProfile}</Text>
              <Text style={styles.saveButtonArrow}>→</Text>
            </>
          )}
        </TouchableOpacity>

        {saveError ? (
          <Text accessibilityRole="alert" style={styles.errorText}>
            {saveError}
          </Text>
        ) : null}

        <Text style={styles.bottomText}>{t.updateLaterNote}</Text>

        <LanguageSelectorModal
          visible={showLangModal}
          onClose={() => setShowLangModal(false)}
        />
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#F3FBF9",
  },
  scrollContent: {
