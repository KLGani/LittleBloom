/**
 * Dynamic Open-Ended Contextual Generator:
 * Generates an empathetic, ChatGPT-structured response for open questions in the target language.
 */
function generateContextualDynamicResponse(userMessage, context = {}, targetLanguage = "English") {
  const name = context.userName || "Mama";
  const week = context.pregnancyWeek;
  const mode = context.mode || "pregnancy";

  const cleanMsg = (userMessage || "").trim();

  // Personalized maternal dynamic synthesizers per language
  if (targetLanguage === "Kannada") {
    return (
      `🌸 ಲಿಟಲ್ ಬ್ಲೂಮ್ ಆರೈಕೆ ಮಾರ್ಗದರ್ಶಿ (${name} ಅವರಿಗೆ):\n\n` +
