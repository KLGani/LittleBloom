import React, { useState } from "react";
import {
  SafeAreaView,
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  Alert,
  ActivityIndicator,
} from "react-native";
import { router } from "expo-router";
import * as SecureStore from "../utils/storage";
import { goBackOrReplace } from "../utils/navigation";

import {
  getPregnancyProfile,
  getChildProfile,
} from "../../services/api";
import { useLanguage } from "../context/LanguageContext";
import { LanguageSelectorModal } from "../components/LanguageSelectorModal";

export default function ModeSelection() {
  const { t, language } = useLanguage();
  const [showLangModal, setShowLangModal] = useState(false);
  const [selectedMode, setSelectedMode] = useState<
    "pregnancy" | "child" | null
  >(null);

  const [loading, setLoading] = useState(false);

  const continueToApp = async () => {
    if (!selectedMode) {
      Alert.alert(
        t.chooseYourMode,
        t.selectJourneyDesc
      );
      return;
    }

    try {
      setLoading(true);

      const token =
        await SecureStore.getItemAsync("authToken");

      const storedUser =
        await SecureStore.getItemAsync("user");

      if (!token) {
        router.replace("/");
        return;
      }

      let user = storedUser
        ? JSON.parse(storedUser)
        : {};

      /*
       * Check whether a profile already exists
       * for the selected mode.
       */

      let profileExists = false;

      if (selectedMode === "pregnancy") {
        const result =
          await getPregnancyProfile(token);

        profileExists =
          result.success &&
          !!result.profile;
      }

      if (selectedMode === "child") {
        const result =
          await getChildProfile(token);

        profileExists =
          result.success &&
          !!result.profile;
      }

      /*
       * Store the selected mode locally.
       * This allows the dashboard to know
       * which mode is currently active.
       */

      user.mode = selectedMode;

      await SecureStore.setItemAsync(
        "user",
        JSON.stringify(user)
      );

      /*
       * If profile already exists,
       * directly open dashboard.
       */

      if (profileExists) {
        router.replace("/dashboard");
        return;
      }

      /*
       * If profile does not exist,
       * ask the user to create it.
       */

      if (selectedMode === "pregnancy") {
        router.push("/pregnancy-profile");
      } else {
        router.push("/child-profile");
      }
    } catch (error) {
      console.log(
        "Mode selection error:",
        error
      );

      Alert.alert(
        t.error,
        "We could not check your profile. Please try again."
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.content}>

        {/* TOP BAR WITH BACK & LANGUAGE TOGGLE */}
        <View style={styles.topBar}>
          <TouchableOpacity
            style={styles.backButton}
            onPress={() => goBackOrReplace("/")}
            disabled={loading}
          >
            <Text style={styles.backText}>
              ‹ {t.back}
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.langPill}
            onPress={() => setShowLangModal(true)}
          >
            <Text style={styles.langPillText}>🌐 {language} ▾</Text>
          </TouchableOpacity>
        </View>

        {/* HEADER */}

        <View style={styles.header}>
          <Text style={styles.logo}>
            🌸
          </Text>

          <Text style={styles.title}>
            {t.chooseYourMode}
          </Text>

          <Text style={styles.subtitle}>
            {t.selectJourneyDesc}
          </Text>
        </View>

        {/* PREGNANCY */}

        <TouchableOpacity
          style={[
            styles.modeCard,
            selectedMode === "pregnancy" &&
              styles.selectedPregnancy,
          ]}
          onPress={() =>
            setSelectedMode("pregnancy")
          }
          activeOpacity={0.85}
          disabled={loading}
        >
          <View style={styles.iconCirclePink}>
            <Text style={styles.modeEmoji}>
              🤰
            </Text>
          </View>

          <View style={styles.modeInfo}>
            <Text style={styles.modeTitle}>
              {t.pregnancyMode}
            </Text>

            <Text style={styles.modeDescription}>
              {t.pregnancyModeDesc}
            </Text>
          </View>

          <View
            style={[
              styles.radio,
              selectedMode === "pregnancy" &&
                styles.radioSelected,
            ]}
          >
            {selectedMode ===
              "pregnancy" && (
              <View style={styles.radioDot} />
            )}
          </View>
        </TouchableOpacity>

        {/* CHILD */}

        <TouchableOpacity
          style={[
            styles.modeCard,
            selectedMode === "child" &&
              styles.selectedChild,
          ]}
          onPress={() =>
            setSelectedMode("child")
          }
          activeOpacity={0.85}
          disabled={loading}
        >
          <View style={styles.iconCircleMint}>
            <Text style={styles.modeEmoji}>
              👶
            </Text>
          </View>

          <View style={styles.modeInfo}>
            <Text style={styles.modeTitle}>
              {t.childMode}
            </Text>

            <Text style={styles.modeDescription}>
              {t.childModeDesc}
            </Text>
          </View>

          <View
            style={[
              styles.radio,
              selectedMode === "child" &&
                styles.radioSelected,
            ]}
          >
            {selectedMode === "child" && (
              <View style={styles.radioDot} />
            )}
          </View>
        </TouchableOpacity>

        {/* CONTINUE */}

        <TouchableOpacity
          style={[
            styles.continueButton,
            (!selectedMode || loading) &&
              styles.disabledButton,
          ]}
          onPress={continueToApp}
          disabled={!selectedMode || loading}
          activeOpacity={0.85}
        >
          {loading ? (
            <ActivityIndicator
              color="#FFFFFF"
            />
          ) : (
            <Text style={styles.continueText}>
              {t.continueBtn}
            </Text>
          )}
        </TouchableOpacity>

        {/* INFO */}

        <View style={styles.infoCard}>
          <Text style={styles.infoEmoji}>
            💗
          </Text>

          <Text style={styles.infoText}>
            {t.tagline}
          </Text>
        </View>

        <LanguageSelectorModal
          visible={showLangModal}
          onClose={() => setShowLangModal(false)}
        />
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
